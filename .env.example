# Copy to .env and fill in. .env is gitignored; never commit real values.

# Neon Postgres. Use the `dev` branch locally.
# Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# Direct connection (no "-pooler"): used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Email (password reset). Leave blank in dev: emails print to the server console.
# Required in production. Use a dedicated Gmail account with an app password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
